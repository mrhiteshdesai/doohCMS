NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5433/smartags
JWT_SECRET=replace-with-a-32-char-or-longer-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUST_PROXY=false
ALLOW_PUBLIC_REGISTRATION=false
HEALTHCHECK_DB_TIMEOUT_MS=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PLAYER_REGISTER_RATE_LIMIT_WINDOW_MS=900000
PLAYER_REGISTER_RATE_LIMIT_MAX=60
PLAYER_STATUS_RATE_LIMIT_WINDOW_MS=900000
PLAYER_STATUS_RATE_LIMIT_MAX=300
HEARTBEAT_RATE_LIMIT_WINDOW_MS=900000
HEARTBEAT_RATE_LIMIT_MAX=120
COMMAND_RATE_LIMIT_WINDOW_MS=60000
COMMAND_RATE_LIMIT_MAX=120
